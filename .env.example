# Dashboard credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password

# Long random values are recommended for both secrets.
WEBHOOK_TOKEN=replace-with-a-long-random-token
SESSION_SECRET=replace-with-another-long-random-secret

# App settings
PORT=3000
DATABASE_PATH=./data/hostname-dashboard.db
OFFLINE_AFTER_MINUTES=15
TRUST_PROXY=false

# Keep false for plain HTTP; set true when the dashboard is served over HTTPS.
SECURE_COOKIES=false
